// 程序图标与版本信息
#define IDI_APPICON 101

#include <windows.h>

// 新版资源文件：exe 图标 + 版本信息
IDI_APPICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,3,0
 PRODUCTVERSION 1,0,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "NCL"
            VALUE "FileDescription",  "Novus Minecraft Launcher Bootstrapper"
            VALUE "FileVersion",      "1.0.3"
            VALUE "InternalName",     "MCLauncherBootstrap"
            VALUE "OriginalFilename", "MCLauncherBootstrap.exe"
            VALUE "ProductName",      "Novus Minecraft Launcher"
            VALUE "ProductVersion",   "1.0.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END