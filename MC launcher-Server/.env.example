# ---------------------------------------------------------------
#  NCL 启动器服务端配置示例
#  复制为 .env 后填写；.env 已在 .gitignore 中，不要提交。
#  systemd 用 EnvironmentFile 读取；pm2 通过 ecosystem.config.js 透传。
# ---------------------------------------------------------------

# 写接口令牌（增删版本 / 指定 latest）
ADMIN_TOKEN=

# ---- 意见反馈（POST /api/feedback）的邮件转发 ----
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com  SMTP_PORT=465  SMTP_SECURE=true
# SMTP_PASS 必须是**授权码**（邮箱设置里开启 SMTP 后生成），不是登录密码
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 收件地址；多个用英文逗号分隔
TARGET_EMAIL=

# 可选：本地反馈日志路径（默认 ./data/feedback.log）
# FEEDBACK_LOG=

# ---- 反向代理 / 隧道（反馈接口按真实 IP 限流时需要）----
# 服务本身**不能**直接暴露公网，否则任何人都能伪造下面的头绕过限流。
# 主站经 Cloudflare 时真实 IP 在 CF-Connecting-IP；经 frp 隧道时在 X-Forwarded-For。
TRUST_PROXY=1
# 只信任来自本机/回环的转发（frpc、同机 nginx）。前面还有一层非本机代理时改成 CIDR。
# TRUST_PROXY_CIDR=loopback
# 可选：只在这些直连地址上才采信 CF-Connecting-IP（逗号分隔）。不填 = 信任所有直连来源。
# CF_TRUSTED=127.0.0.1
